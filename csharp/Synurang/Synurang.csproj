<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;netcoreapp3.1;net5.0;net6.0;net8.0</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Synurang</RootNamespace>
  </PropertyGroup>

  <!-- .NET Framework reference assemblies for cross-platform builds -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- gRPC dependencies (requires netstandard2.0+ / .NET Core 3.0+) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net40'">
    <PackageReference Include="Google.Protobuf" Version="3.25.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.59.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.59.0" />
  </ItemGroup>

  <!-- Exclude gRPC-dependent files from .NET Framework 4.0 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Compile Remove="ProcessHost.cs" />
    <Compile Remove="SynurangCallInvoker.cs" />
    <Compile Remove="PluginStreamReader.cs" />
    <Compile Remove="PluginStreamWriter.cs" />
  </ItemGroup>

</Project>
