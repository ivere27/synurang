const STREAM_STATUS_EOF: u8 = 1;
const STREAM_STATUS_ERROR: u8 = 2;
const STREAM_STATUS_PENDING: u8 = 3;

fn stream_pack(status: u8, payload: &[u8]) -> Vec<u8> {
    let mut out = Vec::with_capacity(1 + payload.len());
    out.push(status);
    out.extend_from_slice(payload);
    out
}

fn stream_status(status: u8) -> Vec<u8> {
    vec![status]
}

