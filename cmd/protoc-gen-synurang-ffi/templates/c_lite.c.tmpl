{{- if and $f.IsRepeated (not $f.IsMap)}}
{{template "c_lite_repeated_elem_type" $f}}* {{$msg.CFunctionPrefix}}_add_{{$f.Name}}(
    {{$msg.CTypeName}}* message) {
    const SynurangLiteAllocator* allocator;
    {{template "c_lite_repeated_elem_type" $f}}* grown;
    size_t capacity;

    if (!message) return NULL;
    allocator = synurang_lite_allocator_or_default(message->_allocator);
    if (message->field_{{$f.Name}}.len == message->field_{{$f.Name}}.cap) {
        /* The allocator has no realloc, so growth allocates, copies, frees.
         * Doubling keeps repeated appends amortized. */
        capacity = message->field_{{$f.Name}}.cap ? message->field_{{$f.Name}}.cap * 2u : 4u;
        if (capacity < message->field_{{$f.Name}}.cap ||
            capacity > SIZE_MAX / sizeof(*grown)) return NULL;
        grown = ({{template "c_lite_repeated_elem_type" $f}}*)allocator->allocate(
            allocator->context, sizeof(*grown) * capacity);
        if (!grown) return NULL;
        memset(grown, 0, sizeof(*grown) * capacity);
        if (message->field_{{$f.Name}}.len) {
            memcpy(grown, message->field_{{$f.Name}}.data,
                   sizeof(*grown) * message->field_{{$f.Name}}.len);
        }
        synurang_lite_release(allocator, message->field_{{$f.Name}}.data);
        message->field_{{$f.Name}}.data = grown;
        message->field_{{$f.Name}}.cap = capacity;
    }
    {
        {{template "c_lite_repeated_elem_type" $f}}* slot =
            &message->field_{{$f.Name}}.data[message->field_{{$f.Name}}.len];
        memset(slot, 0, sizeof(*slot));
{{- if eq $f.ProtoKind "message"}}
        {{$f.CFunctionPrefix}}_init_with_allocator(slot, allocator);
{{- end}}
        message->field_{{$f.Name}}.len++;
