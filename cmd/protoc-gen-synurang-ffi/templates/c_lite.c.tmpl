    }
{{- end}}
    synurang_lite_release(allocator, message->field_{{$f.Name}}.data);
{{- else if or (eq $f.ProtoKind "string") (eq $f.ProtoKind "bytes")}}
    synurang_lite_bytes_clear(allocator, &message->field_{{$f.Name}});
{{- else if eq $f.ProtoKind "message"}}
    if (message->field_{{$f.Name}}) {
        {{$f.CFunctionPrefix}}_free(message->field_{{$f.Name}});
        synurang_lite_release(allocator, message->field_{{$f.Name}});
    }
{{- end}}
{{- end}}
    (void)i;
    memset(message, 0, sizeof(*message));
    message->_allocator = allocator;
}

{{end}}
