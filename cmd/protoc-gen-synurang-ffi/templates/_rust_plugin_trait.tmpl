{{define "rust_plugin_trait"}}
// =============================================================================
// Last Error (thread-local, dlerror()-style)
// =============================================================================

thread_local! {
    static LAST_ERROR: std::cell::RefCell<String> = std::cell::RefCell::new(String::new());
}

fn set_last_error(msg: String) {
    LAST_ERROR.with(|e| *e.borrow_mut() = msg);
}

fn clear_last_error() {
    LAST_ERROR.with(|e| e.borrow_mut().clear());
}

// =============================================================================
// Plugin Trait (unary methods only)
// =============================================================================
{{range $svc := .Services}}
pub trait {{$svc.GoName}}Plugin: Send + Sync + 'static {
{{- range $m := .Methods}}
{{- if $m.IsUnary}}
    fn {{snakeCase $m.Name}}(&self, request: {{$m.InputType}}) -> Result<{{$m.OutputType}}, String>;
{{- end}}
{{- end}}
}

static PLUGIN_{{$svc.GoName | snakeCase | upper}}: OnceLock<Box<dyn {{$svc.GoName}}Plugin>> = OnceLock::new();

/// Register a plugin implementation. Returns `true` on success, `false` if
/// a plugin was already registered (the new plugin is dropped).
pub fn register_{{$svc.GoName | snakeCase}}_plugin(plugin: impl {{$svc.GoName}}Plugin) -> bool {
    PLUGIN_{{$svc.GoName | snakeCase | upper}}.set(Box::new(plugin)).is_ok()
}

fn get_{{$svc.GoName | snakeCase}}_plugin() -> Option<&'static dyn {{$svc.GoName}}Plugin> {
    PLUGIN_{{$svc.GoName | snakeCase | upper}}.get().map(|p| p.as_ref())
}
{{end}}
{{- end}}
