    if (field.oneof != null && (msg as any)[field.oneof] !== field.oneofCase) {
      continue;
    }
    const value = (msg as any)[field.prop];
    if (field.repeated) {
      if (!Array.isArray(value) || value.length === 0) {
        continue;
      }
      if (isPackable(field.kind)) {
        const packed = new ProtoWriter();
        for (const item of value) {
          packed.writeKindBody(field.kind, item);
        }
        writer.writeBytes(field.no, packed.toUint8Array());
      } else {
        for (const item of value) {
          writeFieldValue(writer, field, item);
        }
      }
      continue;
    }
    if (value == null) {
      continue;
    }
    if (!isPresent(msg, field) && isDefaultValue(field, value)) {
      continue;
    }
    writeFieldValue(writer, field, value);
