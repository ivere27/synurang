      } else {
        values.push(readFieldValue(reader, field));
      }
      markPresent(msg, field.no);
      continue;
    }
    (msg as any)[field.prop] = readFieldValue(reader, field);
    markPresent(msg, field.no);
    if (field.oneof != null && field.oneofCase != null) {
      (msg as any)[field.oneof] = field.oneofCase;
    }
