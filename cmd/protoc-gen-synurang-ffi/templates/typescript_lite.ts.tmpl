function isDefaultValue(field: ProtoFieldInfo, value: unknown): boolean {
  switch (field.kind) {
    case "int32":
    case "sint32":
    case "uint32":
    case "fixed32":
    case "sfixed32":
    case "float":
    case "double":
    case "enum":
      return Number(value) === 0;
    case "int64":
    case "sint64":
    case "uint64":
    case "fixed64":
    case "sfixed64":
      return BigInt(value as bigint | number) === 0n;
    case "bool":
      return value === false;
    case "string":
      return value === "";
    case "bytes":
      return value instanceof Uint8Array && value.byteLength === 0;
    case "message":
      return value == null;
  }
}

function messageToJson(msg: LiteMessage, fields: readonly ProtoFieldInfo[]): ProtoJsonObject {
  const out: ProtoJsonObject = {};
  for (const field of fields) {
    if (field.oneof != null && (msg as any)[field.oneof] !== field.oneofCase) {
      continue;
    }
    const value = (msg as any)[field.prop];
    if (field.repeated) {
      if (Array.isArray(value) && value.length > 0) {
        out[field.jsonName] = value.map((item) => valueToJson(field, item));
      }
      continue;
    }
    if (value == null) {
      continue;
    }
    if (!isPresent(msg, field) && isDefaultValue(field, value)) {
      continue;
    }
    out[field.jsonName] = valueToJson(field, value);
  }
  return out;
}

function valueToJson(field: ProtoFieldInfo, value: unknown): ProtoJsonValue {
  switch (field.kind) {
    case "int64":
    case "sint64":
    case "uint64":
    case "fixed64":
    case "sfixed64":
      return BigInt(value as bigint | number).toString();
    case "bytes":
      return value instanceof Uint8Array ? bytesToBase64(value) : "";
    case "enum": {
      const enumName = field.enumType?.[Number(value)];
      return typeof enumName === "string" ? enumName : Number(value);
    }
    case "message":
      if (value instanceof Uint8Array) {
        return bytesToBase64(value);
      }
      if (typeof (value as LiteMessage).toJson === "function") {
        return (value as Required<Pick<LiteMessage, "toJson">>).toJson();
      }
      return {};
    default:
      return value as ProtoJsonValue;
  }
}

function bytesToBase64(bytes: Uint8Array): string {
  const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  let out = "";
  let i = 0;
  for (; i + 2 < bytes.length; i += 3) {
    const n = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2];
    out += alphabet[(n >> 18) & 63] + alphabet[(n >> 12) & 63] + alphabet[(n >> 6) & 63] + alphabet[n & 63];
  }
  if (i < bytes.length) {
    const a = bytes[i];
    const b = i + 1 < bytes.length ? bytes[i + 1] : 0;
    const n = (a << 16) | (b << 8);
    out += alphabet[(n >> 18) & 63] + alphabet[(n >> 12) & 63] + (i + 1 < bytes.length ? alphabet[(n >> 6) & 63] : "=") + "=";
  }
  return out;
}

