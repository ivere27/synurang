      optional: true{{end}}{{if and $f.IsOneof (not $f.IsOptional)}},
      oneof: {{printf "%q" (tsOneofCaseProperty $f)}},
      oneofCase: {{tsOneofCaseValue $msg.Name $f}}{{end}}{{if eq $f.ProtoKind "message"}},
      messageType: {{printf "%q" $f.TypeName}}{{end}}{{if eq $f.ProtoKind "enum"}},
      enumType: {{$f.TypeName}}{{end}},
    },
{{- end}}
  ];

{{- range $g := $groups}}
  {{lowerFirst $g.GoName}}Case: {{tsOneofCaseEnumName $msg.Name $g.GoName}} = {{tsOneofCaseEnumName $msg.Name $g.GoName}}.None;
{{- end}}
