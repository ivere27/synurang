function decodeMessage<T extends LiteMessage>(ctor: MessageConstructor<T>, data: Uint8Array): T {
  const reader = new ProtoReader(data);
  const msg = new ctor();
  while (!reader.eof) {
    const tag = reader.readTag();
    if (tag == null) {
      break;
    }
    const field = ctor.fields.find((candidate) => candidate.no === tag.fieldNo);
    if (field == null) {
      reader.skipField(tag.wireType);
      continue;
    }
    if (field.repeated) {
      const values = ((msg as any)[field.prop] ??= []);
      if (tag.wireType === 2 && isPackable(field.kind)) {
        const packed = new ProtoReader(reader.readLengthDelimited());
