    case "string":
      writer.writeString(field.no, String(value));
      return;
    case "bytes":
      writer.writeBytes(field.no, value as Uint8Array);
      return;
    case "message":
      writer.writeBytes(field.no, encodeMessageValue(field, value));
      return;
    default:
      writer.writeScalar(field.no, field.kind, value);
      return;
  }
}

function encodeMessageValue(field: ProtoFieldInfo, value: unknown): Uint8Array {
  if (value instanceof Uint8Array) {
    return value;
  }
  const lite = value as LiteMessage;
  if (typeof lite.toBinary === "function") {
    return lite.toBinary();
  }
  if (typeof lite.toByteArray === "function") {
    return lite.toByteArray();
  }
  if (field.messageType != null && value != null && typeof value === "object") {
    const ctor = MESSAGE_TYPES[field.messageType];
    if (ctor != null) {
      return new ctor(value as Record<string, unknown>).toBinary!();
